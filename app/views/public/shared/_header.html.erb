<div class="container-fluid py-2 site-header">
  <div class="row w-100 mx-auto">
    <div class="col-12 mx-auto px-4 d-flex align-items-center justify-content-between">

      <%= link_to root_path do %>
        <%= image_tag "sign_logo.png", height: 80, alt: "MogQuest" %>
      <% end %>

      <% if controller_path.start_with?("public/") && authenticated_user? %>
        <div class="welcome-line d-flex align-items-center justify-content-center gap-3">
          <span class="welcome-border"></span>
          <p class="fs-4 mb-0">ようこそ、<%= Current.user.username %>さん！</p>
          <span class="welcome-border"></span>
        </div>
      <% end %>

      <div class="d-flex flex-column">
        <ul class="nav justify-content-end gap-5 me-5">
          <% if controller_path.start_with?("public/") && authenticated_user? %> 
            <li class="nav-item">
              <%= link_to "HOME", root_path, class: "nav-link pop-font fw-bold text-white" %>
            </li>
            <li class="nav-item">
              <%= button_to "ログアウト", destroy_session_path, method: :delete, class: "nav-link pop-font fw-bold text-white" %>
            </li>
          <% else %>
            <li class="nav-item">
              <%= link_to "HOME", root_path, class: "nav-link pop-font fw-bold text-white" %>
            </li>
            <li class="nav-item">
              <%= link_to "新規登録", user_signup_path, class: "nav-link pop-font fw-bold text-white" %>
            </li>
            <li class="nav-item">
              <%= link_to "ログイン", new_session_path, class: "nav-link pop-font fw-bold text-white" %>
            </li>
          <% end %>
        </ul>
      </div>  
    </div>
  </div>
</div>    




