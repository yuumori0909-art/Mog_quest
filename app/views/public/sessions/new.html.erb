<% #ログインフォーム %>
<div class="container">
  <div class="row">
    <div class="col-12 col-md-10 col-lg-8 mx-auto">

      <div class="text-center my-5">
        <%= image_tag "sign_logo.png",class:"sign-logo" %>
      </div>  

      <div class="signin-frame">
        <div class="signin-form text-white">
          <%=form_with url: session_path do |f| %>

            <div class="row mb-4 justify-content-center">
              <label class="pop-font fw-bold col-3 col-form-label">メールアドレス</label>
              <div class="col-4">
                <%= f.email_field :email_address, class: "form-control",style: "border-color: black;", required: true %>
              </div>
            </div>

            <div class="row mb-4 justify-content-center">
              <label class="pop-font fw-bold col-3 col-form-label">パスワード</label>
              <div class="col-4">
                <%= f.password_field :password, class: "form-control",style: "border-color: black;", required: true %>
              </div>
            </div>

            <div class="row mt-5 justify-content-center">
              <div class="pop-font fw-bold col-4">
                <%= f.submit "ログイン", class: "btn btn-signin w-100" %>
              </div>
            </div>

            <% #あとでゲストログイン追加する %>
            
            <div class="row my-4 justify-content-center">
              <div class="pop-font fw-bold col-4">
                <%= f.submit "ゲストログイン（体験版）", class: "btn btn-secondary w-100" %>
              </div>
            </div>

            <div class="row mt-5">
              <h5 class="pop-font fw-bold offset-2">
                ユーザー新規登録がお済みではない方
              </h5>
            </div>
            <div class="row mt-1">
              <h5 class="pop-font fw-bold offset-3">
                <%= link_to "こちら", user_signup_path %>から新規登録してグルメ探索冒険を始めよう！
              </h5>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
