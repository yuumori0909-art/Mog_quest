<% #新規会員登録フォーム %>
<div class="container">
  <div class="row mt-5">
    <div class="col-10">
      <h3 class="bg-light my-5 offset-1 px-4"style="display: inline-block;">新規会員登録</h3>
      <%= form_with model: @user, url: users_path do |f| %>
        <% if @user.errors.any? %>
          <div style="color:red">
          <ul>
            <% @user.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>  
          </div>
        <% end %>

        <div class="row mb-3">
          <label class="col-sm-3 col-form-label">ユーザー名</label>
          <div class="col-4">
            <%= f.text_field :username, class: "form-control",style: "border-color: black;", required: true %>
          </div>
        </div>

        <div class="row mb-3">
          <label class="col-sm-3 col-form-label">メールアドレス</label>
          <div class="col-4">
            <%= f.email_field :email_address, class: "form-control",style: "border-color: black;", required: true %>
          </div>
        </div>    

        <div class="row mb-3">
          <label class="col-sm-3 col-form-label">パスワード（６文字以上）</label>
          <div class="col-4">
            <%= f.password_field :password, class: "form-control",style: "border-color: black;", required: true %>
          </div>
        </div>  

        <div class="row mb-3">
          <label class="col-sm-3 col-form-label">パスワード（確認用）</label>
          <div class="col-4">
            <%= f.password_field :password_confirmation, class: "form-control",style: "border-color: black;", required: true %>
          </div>
        </div>  
        
        <div class="row mb-3">
          <label class="col-sm-3 col-form-label">ユーザー画像</label>
          <div class="col-4">
            <%= f.file_field :profile_image, id: "profile-image-input", accept:"image/*" %>
          </div>
        </div>

        <% if @user.profile_image.attached? %>
          <%= image_tag @user.profile_image, size: "120x120", id: "profile-image-preview" %>
        <% else %>
          <%= image_tag "default_profile.jpg", size: "120x120", id: "profile-image-preview" %>
        <% end %>

        <div class="row mb-3">
          <div class="col-sm-3 offset-sm-3">
          <%= f.submit "新規登録", class: "btn btn-success w-100" %>
          </div>
        </div>

      <% end %>
    </div>
  </div>
</div>



