<% #新規会員登録フォーム %>
<div class="container">
  <div class="row">
    <div class="col-12 col-md-10 col-lg-8 mx-auto">

      <div class="text-center my-5">
        <%= image_tag "sign_logo.png",class:"sign-logo" %>
      </div>  

      <div class="signup-frame">
        <div class="signup-form text-white">
          <%= form_with model: @user, url: users_path do |f| %>
            <% if @user.errors.any? %>
              <div style="color:red">
              <ul>
                <% @user.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>  
              </div>
            <% end %>

            <div class="row mb-4">
              <label class="pop-font fw-bold col-sm-3 col-form-label">ユーザー名(20文字以内)</label>
              <div class="col-4">
                <%= f.text_field :username, class: "form-control",style: "border-color: black;", required: true %>
              </div>
            </div>

            <div class="row mb-4">
              <label class="pop-font fw-bold col-sm-3 col-form-label">メールアドレス</label>
              <div class="col-4">
                <%= f.email_field :email_address, class: "form-control",style: "border-color: black;", required: true %>
              </div>
            </div>    

            <div class="row mb-4">
              <label class="pop-font fw-bold col-sm-3 col-form-label">パスワード（６文字以上）</label>
              <div class="col-4">
                <%= f.password_field :password, class: "form-control",style: "border-color: black;", required: true %>
              </div>
            </div>  

            <div class="row mb-4">
              <label class="pop-font fw-bold col-sm-3 col-form-label">パスワード（確認用）</label>
              <div class="col-4">
                <%= f.password_field :password_confirmation, class: "form-control",style: "border-color: black;", required: true %>
              </div>
            </div>  
            
            <div class="row mb-4">
              <label class="pop-font fw-bold col-sm-3 col-form-label">ユーザー画像</label>
              <div class="col-4">
                <%= f.file_field :profile_image, id: "profile-image-input", accept:"image/*" %>
              </div>
            </div>

            <% if @user.profile_image.attached? %>
              <%= image_tag @user.profile_image, size: "120x120", id: "profile-image-preview" %>
            <% else %>
              <%= image_tag "default_profile.jpg", size: "120x120", id: "profile-image-preview" %>
            <% end %>

            <div class="row my-3">
              <div class="pop-font fw-bold col-sm-3 offset-2">
                <%= f.submit "新規登録", class: "btn btn-warning w-100" %>
              </div>
            </div>
            <h5 class="pop-font fw-bold mt-4">ユーザー登録済みの方</h5>
            <h5 class="pop-font fw-bold mt-3 offset-1"><%= link_to "こちら", new_session_path %>からグルメ探索冒険の続きを始めよう！ </h5>
          <% end %>
        </div>
      </div>  
    </div>
  </div>
</div>



